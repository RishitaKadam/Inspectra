<?xml version="1.0"?>
<sdf version="1.9">
  <world name="inspectra_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Fill light: softens harsh shadows from the main sun light,
         angled toward the robot/conveyor area for a more "rendered" look -->
    <light type="point" name="fill_light">
      <pose>1.2 -0.8 1.8 0 0 0</pose>
      <diffuse>0.5 0.5 0.55 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.3</constant>
        <linear>0.2</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Rim/back light: adds a subtle highlight edge to the robot from behind,
         helps it visually separate from the background -->
    <light type="point" name="rim_light">
      <pose>-0.5 0.8 1.5 0 0 0</pose>
      <diffuse>0.4 0.4 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>6</range>
        <constant>0.3</constant>
        <linear>0.2</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Conveyor: table-style, raised belt surface on 4 legs -->
    <model name="conveyor_belt">
      <static>true</static>
      <pose>0.5 -0.5 0 0 0 0</pose>
      <link name="belt_link">
        <!-- Belt surface (top), sits at z=0 to match table_plane_z used by pose_estimator -->
        <visual name="belt_surface_visual">
          <pose>0 0 -0.02 0 0 0</pose>
          <geometry><box><size>0.5 1.4 0.04</size></box></geometry>
          <material><ambient>0.30 0.18 0.10 1</ambient><diffuse>0.30 0.18 0.10 1</diffuse><specular>0.15 0.10 0.06 1</specular></material>
        </visual>
        <collision name="belt_surface_collision">
          <pose>0 0 -0.02 0 0 0</pose>
          <geometry><box><size>0.5 1.4 0.04</size></box></geometry>
        </collision>

        <!-- 4 legs at the actual 4 corners of the 0.5 x 1.4m belt surface -->
        <visual name="leg_1_visual">
          <pose>0.2 -0.65 -0.02 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.04</size></box></geometry>
          <material><ambient>0.15 0.1 0.05 1</ambient><diffuse>0.15 0.1 0.05 1</diffuse></material>
        </visual>
        <collision name="leg_1_collision">
          <pose>0.2 -0.65 -0.02 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.04</size></box></geometry>
        </collision>

        <visual name="leg_2_visual">
          <pose>-0.2 -0.65 -0.02 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.04</size></box></geometry>
          <material><ambient>0.15 0.1 0.05 1</ambient><diffuse>0.15 0.1 0.05 1</diffuse></material>
        </visual>
        <collision name="leg_2_collision">
          <pose>-0.2 -0.65 -0.02 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.04</size></box></geometry>
        </collision>

        <visual name="leg_3_visual">
          <pose>0.2 0.65 -0.02 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.04</size></box></geometry>
          <material><ambient>0.15 0.1 0.05 1</ambient><diffuse>0.15 0.1 0.05 1</diffuse></material>
        </visual>
        <collision name="leg_3_collision">
          <pose>0.2 0.65 -0.02 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.04</size></box></geometry>
        </collision>

        <visual name="leg_4_visual">
          <pose>-0.2 0.65 -0.02 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.04</size></box></geometry>
          <material><ambient>0.15 0.1 0.05 1</ambient><diffuse>0.15 0.1 0.05 1</diffuse></material>
        </visual>
        <collision name="leg_4_collision">
          <pose>-0.2 0.65 -0.02 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.04</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- 3 PCB models on the conveyor (moved by conveyor_motion_node) -->
    <model name="pcb_1">
      <static>true</static>
      <pose>0.5 -0.9 0.012 0 0 0</pose>
      <link name="pcb_link">
        <visual name="pcb_visual">
          <geometry><box><size>0.08 0.08 0.01</size></box></geometry>
          <material><ambient>0.0 0.8 0.2 1</ambient><diffuse>0.0 0.8 0.2 1</diffuse></material>
        </visual>
        <collision name="pcb_collision">
          <geometry><box><size>0.08 0.08 0.01</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="pcb_2">
      <static>true</static>
      <pose>0.5 -0.6 0.012 0 0 0</pose>
      <link name="pcb_link">
        <visual name="pcb_visual">
          <geometry><box><size>0.08 0.08 0.01</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
        <collision name="pcb_collision">
          <geometry><box><size>0.08 0.08 0.01</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="pcb_3">
      <static>true</static>
      <pose>0.5 -0.3 0.012 0 0 0</pose>
      <link name="pcb_link">
        <visual name="pcb_visual">
          <geometry><box><size>0.08 0.08 0.01</size></box></geometry>
          <material><ambient>0.0 0.8 0.2 1</ambient><diffuse>0.0 0.8 0.2 1</diffuse></material>
        </visual>
        <collision name="pcb_collision">
          <geometry><box><size>0.08 0.08 0.01</size></box></geometry>
        </collision>
      </link>
    </model>
    <!-- PASS bin (green, right) -->
    <model name="pass_bin">
      <static>true</static>
      <pose>0.35 0.35 0.05 0 0 0</pose>
      <link name="bin_link">
        <visual name="bin_visual">
          <geometry><box><size>0.2 0.2 0.1</size></box></geometry>
          <material><ambient>0.0 0.8 0.2 1</ambient><diffuse>0.0 0.8 0.2 1</diffuse></material>
        </visual>
        <collision name="bin_collision">
          <geometry><box><size>0.2 0.2 0.1</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- FAIL bin (red, left) -->
    <model name="fail_bin">
      <static>true</static>
      <pose>-0.35 -0.35 0.05 0 0 0</pose>
      <link name="bin_link">
        <visual name="bin_visual">
          <geometry><box><size>0.2 0.2 0.1</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
        <collision name="bin_collision">
          <geometry><box><size>0.2 0.2 0.1</size></box></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
