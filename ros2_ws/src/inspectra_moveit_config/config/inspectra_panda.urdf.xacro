<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="inspectra_panda">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import inspectra_panda urdf file -->
    <xacro:include filename="$(find inspectra_description)/urdf/inspectra_panda.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="inspectra_panda.ros2_control.xacro" />


    <xacro:inspectra_panda_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
